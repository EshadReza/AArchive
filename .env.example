# Backend and local service configuration (S002/S004).
# Copy to ignored .env and use `uv run --locked --env-file .env ...`.
# Replace placeholders locally. Never commit real secrets.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Fixed session lifetime and shared login attempt budgets (S008).
AUTH_SESSION_SECONDS=43200
AUTH_LOGIN_ATTEMPT_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_WINDOW_SECONDS=900
DATABASE_URL=postgresql://aarchive:replace-local-password@localhost:5432/aarchive
# Tests ignore DATABASE_URL. Future database tests need a disposable PostgreSQL
# database and a role permitted to create its test database.
TEST_DATABASE_URL=postgresql://aarchive:replace-local-password@localhost:5432/aarchive_test

# Compose service credentials/ports. Keep DATABASE_URL in sync with these values.
POSTGRES_DB=aarchive
POSTGRES_USER=aarchive
POSTGRES_PASSWORD=replace-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379
# Redis is available locally; backend jobs/cache are implemented in later sprints.
REDIS_URL=redis://localhost:6379/0

# Planned configuration for later sprints; not consumed by the current backend.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/assets
IMPORT_STAGING_ROOT=./data/staging
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Implemented registration/mail configuration.
# Registration is disabled until explicit institutional domains are supplied.
# Exact domains only, comma separated; subdomains are not implicitly allowed.
INSTITUTIONAL_EMAIL_DOMAINS=
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
REGISTRATION_REQUIRE_APPROVAL=false
VERIFICATION_TOKEN_SECONDS=86400
INVITATIONS_ENABLED=true
INVITATION_SECONDS=86400
INVITATION_RESEND_SECONDS=60
# Local reset mail uses the console. Production must configure HTTPS origin/SMTP.
PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_SECONDS=3600
RECOVERY_IDENTITY_LIMIT=3
RECOVERY_IP_LIMIT=30
RECOVERY_WINDOW_SECONDS=900
REGISTRATION_EMAIL_LIMIT=3
REGISTRATION_IP_LIMIT=30
REGISTRATION_WINDOW_SECONDS=900
# Development prints mail to its console; tests capture mail; production uses SMTP.
DEFAULT_FROM_EMAIL=no-reply@archive.example.invalid
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# S003 frontend uses same-origin /api paths and needs no environment variables.
# Future VITE_ variables are public browser configuration; never put secrets in them.
