# Secrets and machine-specific configuration. Commit safe examples instead.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
credentials.local.*

# Python environments, bytecode, tool caches, and build output.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# JavaScript dependencies, generated assets, and test artifacts.
node_modules/
dist/
build/
coverage/
.vite/
playwright-report/
test-results/
*.tsbuildinfo

